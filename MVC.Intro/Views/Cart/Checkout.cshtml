@{
    ViewData["Title"] = "Поръчката е приета";
}

<section class="tickets-section">
    <div class="container">
        <div class="tickets-card text-center py-5 tickets-success">
            <div class="tickets-crest mx-auto mb-3" style="font-size: 3rem;">🎫</div>
            <h1 class="tickets-title">Благодарим ти!</h1>
            <p class="tickets-muted">Поръчката е приета. Артикули: @ViewBag.ItemCount · Сума: @(((decimal)ViewBag.Total).ToString("0.00")) €</p>
            <a class="btn tickets-btn-primary mt-3" asp-controller="Home" asp-action="Index">Обратно в магазина</a>
        </div>
    </div>
</section>
