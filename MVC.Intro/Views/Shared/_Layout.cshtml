<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Tickets</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MVC.Intro.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <header class="tickets-header">
        <div class="tickets-stripe"></div>
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand tickets-brand" asp-controller="Home" asp-action="Index">
                    <span class="tickets-logo">🎫</span>
                    <span>
                        <strong>Tickets</strong>
                        <small>Спортни билети за всички събития</small>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#ticketsNav" aria-controls="ticketsNav" aria-expanded="false" aria-label="Меню">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="ticketsNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Събития</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Event" asp-action="Index">Каталог</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Privacy">За нас</a>
                        </li>
                        <li class="nav-item">
                            @await Component.InvokeAsync("CartBadge")
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var fullName = User.Identity.Name ?? "?";
                            var role = User.IsInRole("Admin") ? "Admin" : "User";

                            // Build initials: up to 2 words → first letter each
                            var nameParts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                            var initials = nameParts.Length >= 2
                                ? $"{nameParts[0][0]}{nameParts[1][0]}"
                                : fullName.Length >= 2 ? fullName[..2] : fullName;
                            initials = initials.ToUpper();

                            var roleClass = role == "Admin" ? "tickets-avatar--admin" : "tickets-avatar--user";
                            var roleBadgeClass = role == "Admin" ? "tickets-role-badge--admin" : "tickets-role-badge--user";

                            <li class="nav-item d-flex align-items-center gap-2">
                                <div class="tickets-avatar @roleClass" title="@fullName (@role)">
                                    @initials
                                </div>
                                <div class="d-flex flex-column lh-1">
                                    <span class="tickets-user">@fullName</span>
                                    <span class="tickets-role-badge @roleBadgeClass">@role</span>
                                </div>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                    <button type="submit" class="btn btn-sm tickets-btn-ghost">Изход</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn tickets-btn-primary" asp-controller="Account" asp-action="Login">Вход</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @if (TempData["Notice"] is string notice)
        {
            <div class="container pt-3">
                <div class="alert tickets-alert mb-0">@notice</div>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="tickets-footer">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span>© @DateTime.Now.Year Tickets · Вашият билет за спорта</span>
            <a asp-controller="Home" asp-action="Privacy">За нас</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
