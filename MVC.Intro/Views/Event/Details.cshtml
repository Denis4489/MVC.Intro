@section Scripts {
<script>
    const basePrice = @Model.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
    let currentMultiplier = 1.4;

    function selectSector(name, multiplier, desc, color) {
        currentMultiplier = multiplier;
        
        // Update display text
        document.getElementById('displaySectorName').textContent = name;
        document.getElementById('displaySectorDesc').textContent = desc;
        
        // Update form hidden fields
        document.getElementById('formSector').value = name;

        // Synchronize dropdown
        const select = document.getElementById('sectorSelect');
        for (let i = 0; i < select.options.length; i++) {
            if (select.options[i].value === name) {
                select.selectedIndex = i;
                break;
            }
        }

        // Highlight sector on SVG
        document.querySelectorAll('.stadium-sector').forEach(el => el.classList.remove('selected'));
        
        // Attempt to find element matching sector id (e.g. 'sec-104')
        const sectorNum = name.match(/\d+/);
        if (sectorNum) {
            const svgElement = document.getElementById('sec-' + sectorNum[0]);
            if (svgElement) {
                svgElement.classList.add('selected');
            }
        }

        calculateTotal();
    }

    function onSectorDropdownChange() {
        const select = document.getElementById('sectorSelect');
        const option = select.options[select.selectedIndex];
        const name = option.value;
        const multiplier = parseFloat(option.getAttribute('data-rate'));
        const desc = option.getAttribute('data-desc');
        const color = option.getAttribute('data-color');
        
        selectSector(name, multiplier, desc, color);
    }

    function adjustQty(delta) {
        const input = document.getElementById('qtyInput');
        let val = parseInt(input.value) || 1;
        val = Math.max(1, Math.min(10, val + delta));
        input.value = val;
        calculateTotal();
    }

    function calculateTotal() {
        const input = document.getElementById('qtyInput');
        let qty = parseInt(input.value) || 1;
        if (qty < 1) qty = 1;

        const unitPrice = basePrice * currentMultiplier;
        const total = unitPrice * qty;

        document.getElementById('unitPriceDisplay').textContent = unitPrice.toFixed(2) + ' €';
        document.getElementById('totalPriceDisplay').textContent = total.toFixed(2) + ' €';
        document.getElementById('formPrice').value = unitPrice.toFixed(2);
    }

    // Initialize total calculation
    calculateTotal();
</script>
}
