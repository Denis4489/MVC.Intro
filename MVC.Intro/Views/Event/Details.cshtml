@model MVC.Intro.Models.Event
@{
    ViewData["Title"] = $"{Model.Name} - Избор на сектор и билети";
    var catalog = MVC.Intro.Services.EventCatalog.Get(Model.Name);
    var basePrice = Model.Price;
}

<section class="tickets-section">
    <div class="container">
        <!-- Event Header Card -->
        <div class="tickets-card p-4 p-md-5 mb-4">
            <div class="row align-items-center g-4">
                <div class="col-lg-7">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-primary px-3 py-1 text-uppercase">@catalog.Category</span>
                        <span class="badge bg-warning text-dark px-3 py-1 text-uppercase fw-bold">@Model.TicketType</span>
                    </div>
                    <h1 class="display-6 fw-bold text-white mb-3">@Model.Name</h1>
                    <p class="tickets-muted fs-5 mb-4">@catalog.Description</p>

                    <div class="d-flex flex-wrap gap-4 text-white-50">
                        <div>
                            <span class="text-white fw-semibold d-block">📍 Стадион / Място</span>
                            @Model.Venue
                        </div>
                        <div>
                            <span class="text-white fw-semibold d-block">📅 Дата и час</span>
                            @Model.EventDate.ToString("dd MMM yyyy, HH:mm") ч.
                        </div>
                        <div>
                            <span class="text-white fw-semibold d-block">👥 Налични места</span>
                            @Model.AvailableTickets от @Model.Capacity
                        </div>
                    </div>
                </div>

                <div class="col-lg-5 text-lg-end">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded-4 shadow" style="max-height: 220px; object-fit: cover;" />
                    }
                </div>
            </div>
        </div>

        <!-- Stadium Sector Selection Section -->
        <div class="stadium-card p-4 p-xl-5 mb-5">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
                <div>
                    <p class="tickets-kicker m-0">Интерактивна схема на стадиона</p>
                    <h2 class="fs-3 fw-bold text-white m-0">Изберете сектор за настаняване</h2>
                    <small class="tickets-muted">Кликнете върху сектор от схемата или го изберете от менюто</small>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-sm tickets-btn-ghost" data-bs-toggle="modal" data-bs-target="#stadiumImageModal">
                        🔍 Уголеми официалната схема
                    </button>
                    @if (User.IsInRole("Admin"))
                    {
                        <a class="btn btn-sm tickets-btn-ghost" asp-action="Edit" asp-route-id="@Model.Id">Редактирай събитие</a>
                    }
                </div>
            </div>

            <!-- Stadium Category Legend -->
            <div class="d-flex flex-wrap gap-2 mb-4 justify-content-center">
                <div class="stadium-legend-item" onclick="selectSector('Сектор 104 (VIP)', 1.4, 'VIP Президентска ложа', '#f59e0b')">
                    <span class="stadium-color-dot" style="background-color: #f59e0b;"></span>
                    <span>VIP Ложи (001-003, 104, 801-802)</span>
                </div>
                <div class="stadium-legend-item" onclick="selectSector('Сектор 102 (Категория 1)', 1.2, 'Категория 1 - Долен етаж централна трибуна', '#2563eb')">
                    <span class="stadium-color-dot" style="background-color: #2563eb;"></span>
                    <span>Кат. 1 - Долен етаж (101-109, 119-124)</span>
                </div>
                <div class="stadium-legend-item" onclick="selectSector('Сектор 305 (Категория 2)', 1.15, 'Категория 2 - Среден етаж панорамен изглед', '#f97316')">
