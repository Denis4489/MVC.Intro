@model MVC.Intro.Models.Event
@{
    ViewData["Title"] = Model.Name;
    var catalog = MVC.Intro.Services.EventCatalog.Get(Model.Name);
}

<section class="tickets-section">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-5">
                <div class="tickets-card accent-@catalog.Accent">
                    <div class="tickets-card-art tickets-card-art-lg">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" alt="@Model.Name" class="product-image" />
                        }
                        else
                        {
                            <span>🎫</span>
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="tickets-card-bg">
                    <small class="tickets-kicker">@catalog.Category</small>
                    <h1 class="tickets-title">@Model.Name</h1>
                    <p>@catalog.Description</p>
                    <p><strong>Дата:</strong> @Model.EventDate.ToString("dd MMM yyyy, HH:mm")</p>
                    <p><strong>Място:</strong> @Model.Venue</p>
                    <p><strong>Тип билет:</strong> @Model.TicketType</p>
                    <p><strong>Налични билети:</strong> @Model.AvailableTickets / @Model.Capacity</p>
                    <p class="fs-3 fw-bold">@Model.Price.ToString("0.00") €</p>
                    <form asp-controller="Cart" asp-action="Add" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button class="btn tickets-btn-primary" type="submit">🛒 Добави в количка</button>
                        <a class="btn tickets-btn-ghost" asp-action="Index">Назад</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
