                <div class="stadium-legend-item" onclick="selectSector('Сектор 252 (Източна трибуна)', 0.9, 'Източна трибуна - Гостуващи фенове и агитка', '#065f46')">
                    <span class="stadium-color-dot" style="background-color: #065f46;"></span>
                    <span>Източна трибуна (248-260, 451-453)</span>
                </div>
                <div class="stadium-legend-item" onclick="selectSector('Сектор 112 (Западна трибуна)', 1.0, 'Западна трибуна - Зад вратата', '#65a30d')">
